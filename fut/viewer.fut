-- Slide effects, called from SML via smlfut.
--
-- Images are exchanged with the SML side as [h][w][4]u8 arrays of RGBA
-- bytes, which is the pixel layout used by tigr.

import "lib/github.com/athas/matte/colour"
import "lib/github.com/diku-dk/sorts/radix_sort"
import "lib/github.com/diku-dk/cpprandom/random"
import "nbody"
import "sand"

-- The bodies are stored as plain arrays rather than as records, because the
-- SML bindings generated by smlfut for MLKit cannot handle records with
-- floating-point fields.  Each body is a position, mass, and velocity packed
-- into a [5]real, plus its colour.
type~ state [h][w][n] = { image: [h][w]argb.colour
                        , bodies: [n][5]real
                        , orig_bodies: [n][5]real
                        , colours: [n]argb.colour
                        , offset: i64
                        , reverting: bool
                        , background: argb.colour }

def pack_body ((pos, mass, vel, _): body): [5]real =
  [pos.x, pos.y, mass, vel.x, vel.y]

def unpack_body (p: [5]real) (colour: argb.colour): body =
  ({x = p[0], y = p[1]}, p[2], {x = p[3], y = p[4]}, colour)

def get_bodies [h][w][n] (s: state [h][w][n]): [n]body =
  map2 unpack_body s.bodies s.colours

def set_bodies [h][w][n] (s: state [h][w][n]) (bodies: [n]body): state [h][w][n] =
  s with bodies = map pack_body bodies

def pack (p: [4]u8): argb.colour =
  (u32.u8 p[3] << 24) | (u32.u8 p[0] << 16) | (u32.u8 p[1] << 8) | u32.u8 p[2]

def unpack (c: argb.colour): [4]u8 =
  [u8.u32 (c >> 16), u8.u32 (c >> 8), u8.u32 c, u8.u32 (c >> 24)]

def from_colours [h][w] (image: [h][w]argb.colour): state [h][w][0] =
  { image
  , bodies = []
  , orig_bodies = []
  , colours = []
  , offset = 0
  , reverting = false
  , background = argb.black -- dummy
  }

entry load_image [h][w] (pixels: [h][w][4]u8): state [h][w][0] =
  from_colours (map (map pack) pixels)

-- The image at its native resolution, with any bodies drawn on top.
def render_native [h][w][n] (s: state [h][w][n]): [h][w]argb.colour =
  if n == 0
  then s.image
  else let (is, vs) = unzip (map (render_body h w) (get_bodies s))
       in unflatten (scatter (replicate (h*w) s.background) is vs)

-- Scale the image to be as large as possible within a H*W frame while
-- preserving its aspect ratio, centered on a black background.  Uses
-- bilinear interpolation.
def scale_to_fit [h][w] (H: i64) (W: i64) (image: [h][w]argb.colour): [H][W][4]u8 =
  let (th, tw) = if W * h <= H * w
                 then (i64.max 1 (W * h / w), W)
                 else (H, i64.max 1 (H * w / h))
  let oy = (H - th) / 2
  let ox = (W - tw) / 2
  -- The two neighbouring source coordinates (out of s) for destination
  -- coordinate i (out of t), and the weight of the second one.
  let neighbours (s: i64) (t: i64) (i: i64) =
    let p = f32.max 0 ((f32.i64 i + 0.5) * f32.i64 s / f32.i64 t - 0.5)
    let i0 = i64.min (i64.f32 p) (s - 1)
    in (i0, i64.min (i0 + 1) (s - 1), p - f32.i64 i0)
  let channels c = map f32.u8 (unpack c)
  let lerp a b f = map2 (\x y -> x * (1 - f) + y * f) a b
  let sample y x =
    let i = y - oy
    let j = x - ox
    in if i < 0 || i >= th || j < 0 || j >= tw
       then [0, 0, 0, 255]
       else let (i0, i1, fi) = neighbours h th i
            let (j0, j1, fj) = neighbours w tw j
            let top = lerp (channels image[i0, j0]) (channels image[i0, j1]) fj
            let bot = lerp (channels image[i1, j0]) (channels image[i1, j1]) fj
            in map (u8.f32 <-< f32.round) (lerp top bot fi) with [3] = 255
  in tabulate_2d H W sample

entry render [h][w][n] (H: i64) (W: i64) (s: state [h][w][n]): [H][W][4]u8 =
  scale_to_fit H W (render_native s)

-- Replace the image with what is currently shown, and remove any bodies.
-- Used before starting the sand effect.
entry freeze [h][w][n] (s: state [h][w][n]): state [h][w][0] =
  from_colours (render_native s)

def most_common_colour [h][w] (image: [h][w]argb.colour): argb.colour =
  let xs = radix_sort u32.num_bits u32.get_bit (flatten image)
  let n = length xs
  let starts = filter (\i -> i == 0 || xs[i] != xs[i-1]) (iota n)
  let lens = map2 (\k i -> (if k + 1 < length starts then starts[k+1] else n) - i)
                  (indices starts) starts
  let longest (l1, i1) (l2, i2) =
    if l1 > l2 || (l1 == l2 && i1 <= i2) then (l1, i1) else (l2, i2)
  let (_, i) = reduce_comm longest (0, 0) (zip lens starts)
  in xs[i]

entry start_nbody [h][w][n] (s: state [h][w][n]): state [h][w][] =
  let background = most_common_colour s.image
  let bodies = bodies_from_image background s.image
  let packed = map pack_body bodies
  in s with bodies = packed
       with orig_bodies = packed
       with colours = map (.3) bodies
       with background = background
       with offset = 0
       with reverting = false

def num_attractors (n: i64) = i64.max 64 (i64.f32 (8000 / f32.i64 (i64.max 1 n)))

entry revert [h][w][n] (s: state [h][w][n]): state [h][w][n] =
  s with reverting = !s.reverting

entry advance [h][w][n] (s: state [h][w][n]): state [h][w][n] =
  let chunk_size = i64.min (num_attractors n) (n - s.offset)
  let fwd_time_step = 0.1 * 5
  let rev_time_step = 0.2
  let bodies = get_bodies s
  let orig_bodies = map2 unpack_body s.orig_bodies s.colours
  let attractors = bodies[s.offset:s.offset+chunk_size]
  in set_bodies s (if s.reverting
                   then revert_bodies (real.i64 w) (real.i64 h) 50 rev_time_step bodies orig_bodies
                   else advance_bodies (real.i64 w) (real.i64 h) 50 fwd_time_step bodies attractors)
       with offset = if n > 0
                     then (s.offset + num_attractors n) % n
                     else 0

module engine = minstd_rand
module distribution = uniform_real_distribution real engine

entry shuffle [h][w][n] (seed: i32) (s: state [h][w][n]): state [h][w][n] =
  let rng = engine.rng_from_seed [seed]
  let move (rng: engine.rng) ((_, mass, velocity, colour) : body) =
    let (rng, x) = distribution.rand (0, real.i64 h) rng
    let (_, y) = distribution.rand (0, real.i64 w) rng
    in ({x, y}, mass, velocity, colour)
  in set_bodies s (map2 move (engine.split_rng n rng) (get_bodies s))

-- The sand simulation works on 2x2 blocks, so it is applied to the largest
-- even-sized part of the image; an odd last row or column stays put.
entry drop_sand [h][w][n] (i: i32) (s: state [h][w][n]): state [h][w][n] =
  let h' = h - h % 2
  let w' = w - w % 2
  let image = copy s.image
  let image[:h', :w'] = drop_pixels i s.image[:h', :w']
  in s with image = image
